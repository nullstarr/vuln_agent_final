# Copy to .env and fill in. Never commit the real .env file.

# rule_based (default, no key needed - this is sample mode) | anthropic | openai | ollama
LLM_PROVIDER=rule_based

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama runs fully locally - no key, no cost, no external network call.
# Needs a running Ollama service on the same machine (see README).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# LLM_PROVIDER=nvidia  (NVIDIA-gehostete Modelle; Schluessel und aktuellen Modellnamen im HackOS-Ordner holen)
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Zetaris (data layer). Local install from the Participant Setup Guide; create the API key in the Zetaris web UI.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# LLM_PROVIDER=meterless  (Meterless Runtime / Nightshift as AI provider; copy URL and token from the Nightshift Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Nemotron 3.5 is a reasoning model: raise the token limit and/or switch the thinking off (see agents/llm_provider.py)
NVIDIA_MAX_TOKENS=600
# NVIDIA_ENABLE_THINKING=false
